<?xml version="1.0" encoding="UTF-8"?>
<phpunit colors="true"
         processIsolation="false"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="Tests">
            <directory suffix="Test.php">./test</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <env name="SWOOLE_HOOK_FLAGS" value="0"/>
        <env name="SWOOLE_ENABLE_COROUTINE" value="Off"/>
        <env name="TOTP_VERIFICATION_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
